#
# Platform probing: architecture, integer widths, native integer size and math backend.
#

if(CMAKE_HOST_UNIX OR MINGW)
    execute_process(COMMAND uname -m OUTPUT_VARIABLE CIPHER_ARCHITECTURE OUTPUT_STRIP_TRAILING_WHITESPACE)
else()
    set(CIPHER_ARCHITECTURE "unknown")
endif()
if(CIPHER_ARCHITECTURE MATCHES "i386")
    message(SEND_ERROR "The ${CIPHER_ARCHITECTURE} architecture is not supported")
else()
    message(STATUS "Architecture is ${CIPHER_ARCHITECTURE}")
endif()

include(CheckTypeSize)
check_type_size("__int128" INT128)
check_type_size("uint64_t" INT64)
if(EMSCRIPTEN)
    # Emscripten always provides uint64_t, but check_type_size() is unreliable when cross-compiling.
    set(HAVE_INT64 1)
endif()

# Native integer width
if(CIPHER_NATIVE_SIZE EQUAL 128)
    if(EMSCRIPTEN)
        message(SEND_ERROR "CIPHER_NATIVE_SIZE=128 is not supported with Emscripten")
    endif()
    if(NOT HAVE_INT128)
        message(SEND_ERROR "CIPHER_NATIVE_SIZE=128 needs a compiler with __int128")
    endif()
elseif(CIPHER_NATIVE_SIZE EQUAL 64)
    if(NOT HAVE_INT64)
        message(SEND_ERROR "CIPHER_NATIVE_SIZE=64 needs uint64_t")
    endif()
elseif(CIPHER_NATIVE_SIZE EQUAL 32)
    if(NOT HAVE_INT64)
        message(SEND_ERROR "CIPHER_NATIVE_SIZE=32 needs uint64_t")
    endif()
    set(HAVE_INT128 FALSE)
else()
    message(SEND_ERROR "CIPHER_NATIVE_SIZE must be 32, 64 or 128 (got ${CIPHER_NATIVE_SIZE})")
endif()
set(CIPHER_NATIVE_INT ${CIPHER_NATIVE_SIZE})
message(STATUS "Native integer width: ${CIPHER_NATIVE_INT}")

# Math backend: the default backend is always compiled in.
if(CIPHER_NATIVE_INT EQUAL 128)
    if(CIPHER_MATH_BACKEND EQUAL 6)
        message(STATUS "Math backend 6 does not work with 128-bit native integers; using backend 4")
        set(CIPHER_MATH_BACKEND 4)
    endif()
    if(CIPHER_WITH_NTL)
        message(STATUS "Math backend 6 does not work with 128-bit native integers; disabling NTL")
        set(CIPHER_WITH_NTL OFF)
    endif()
endif()

if(CIPHER_MATH_BACKEND EQUAL 2)
    set(CIPHER_WITH_BE2 ON)
elseif(CIPHER_MATH_BACKEND EQUAL 4)
    set(CIPHER_WITH_BE4 ON)
elseif(CIPHER_MATH_BACKEND EQUAL 6)
    set(CIPHER_WITH_NTL ON)
else()
    message(SEND_ERROR "CIPHER_MATH_BACKEND must be 2, 4 or 6")
endif()
message(STATUS "Default math backend: ${CIPHER_MATH_BACKEND}")
